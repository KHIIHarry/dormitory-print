# DormPrint application environment (placeholders only).
#
# Copy this file to backend/.env.local for local runs, or to deploy/.env when
# using deploy/compose.yaml.  Never commit a real key, database password or
# SMTP credential.  The application reads DORMPRINT_* variables only.
DORMPRINT_ENVIRONMENT=production
DORMPRINT_PUBLIC_ORIGIN=https://print.example.com
DORMPRINT_SECURE_COOKIES=true

# At least 32 characters.  Keep the real value in an independent secret
# manager; it is intentionally NOT part of the file/database backup set.
DORMPRINT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# In production the database and Redis are reachable only on the internal
# Compose network.  Replace both passwords before the first start.
DORMPRINT_DATABASE_URL=postgresql+psycopg://dormprint:replace-database-password@postgres:5432/dormprint
DORMPRINT_REDIS_URL=redis://:replace-redis-password@redis:6379/0
DORMPRINT_STORAGE_ROOT=/var/lib/dormprint

DORMPRINT_MAX_REQUEST_BYTES=230686720
DORMPRINT_IDEMPOTENCY_HOURS=24
DORMPRINT_SOFFICE_PATH=/usr/bin/soffice
DORMPRINT_GHOSTSCRIPT_PATH=/usr/bin/gs
DORMPRINT_CONVERSION_TIMEOUT_SECONDS=120
DORMPRINT_WORKER_LEASE_SECONDS=180

# SMTP targets are configured in the admin UI, not in this file.  This
# allowlist is a deployment fact and must contain the real SMTP hostname.
DORMPRINT_MAIL_ALLOWED_HOSTS=smtp.example.com
DORMPRINT_ALLOW_INSECURE_SMTP=false
DORMPRINT_ALLOW_INTERNAL_SMTP=false
DORMPRINT_MAIL_TIMEOUT_SECONDS=10
DORMPRINT_MAIL_PAYLOAD_TTL_HOURS=72
DORMPRINT_MAIL_RETRY_MAX_ATTEMPTS=5
DORMPRINT_EXPORT_MAX_ROWS=10000

# Optional: record sha256(secret) out-of-band so a restore can verify the
# independently restored master key.  Do not put the secret itself here.
# DORMPRINT_MASTER_KEY_FINGERPRINT=
