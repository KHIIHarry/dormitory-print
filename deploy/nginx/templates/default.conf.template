# Same-origin HTTP entry point rendered by the nginx-unprivileged entrypoint.
# It listens on 8080 inside the container; Compose publishes it on loopback.
server {
    listen 8080 default_server;
    server_name ${DORMPRINT_PUBLIC_HOST} _;

    root /usr/share/nginx/html;
    index index.html;

    # Matches DORMPRINT_MAX_REQUEST_BYTES.  Nginx rejects oversized bodies
    # before the application sees them; the app still validates the limit.
    client_max_body_size ${DORMPRINT_UPLOAD_LIMIT_MB}m;
    client_body_timeout 300s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Private API and binary downloads.  They are never cached, never served
    # from the static tree and preserve Range/If-Range for resumed downloads.
    location /api/ {
        access_log off;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;

        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size ${DORMPRINT_UPLOAD_LIMIT_MB}m;

        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # PWA control files must not be cached, even though hashed assets are.
    location ~ ^/(u|manage|courier)/(sw\.js|manifest\.webmanifest)$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA entry points share the same shell. Manifest directories must not
    # match as directory indexes; both root paths and deep links use index.html.
    location /u/ {
        try_files $uri /index.html;
    }

    location /manage/ {
        try_files $uri /index.html;
    }

    location /courier/ {
        try_files $uri /index.html;
    }

    location / {
        try_files $uri /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    location ~ /\. {
        deny all;
    }
}
