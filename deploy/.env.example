# DormPrint deploy environment (placeholders only).  Copy to deploy/.env,
# chmod 600 deploy/.env, fill real values, and never commit it.
#
# This file is read by Docker Compose for variable interpolation.  Application
# values are passed to containers explicitly in compose.yaml.

POSTGRES_PASSWORD=replace-database-password
REDIS_PASSWORD=replace-redis-password

DORMPRINT_ENVIRONMENT=production

# At least 32 characters, generated with e.g. `openssl rand -base64 48`.
DORMPRINT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
DORMPRINT_PUBLIC_ORIGIN=https://print.example.com
DORMPRINT_PUBLIC_HOST=print.example.com
# Plaintext entry is loopback-only by default.  Put a TLS terminator in front
# and change this only after TLS is verified.
DORMPRINT_BIND_ADDRESS=127.0.0.1
DORMPRINT_HTTP_PORT=8080
DORMPRINT_UPLOAD_LIMIT_MB=220
DORMPRINT_MAX_REQUEST_BYTES=230686720
DORMPRINT_MAIL_ALLOWED_HOSTS=smtp.example.com
# Initial username and explicitly verified base-account email. The password is entered interactively and is never
# stored in this file or in Compose defaults.
DORMPRINT_INITIAL_ADMIN_USERNAME=admin
DORMPRINT_INITIAL_ADMIN_EMAIL=

# Keep this fingerprint with the master key in the secret manager, not with
# the backup repository.  Empty means "not recorded", so restore will warn.
DORMPRINT_MASTER_KEY_FINGERPRINT=

# Encrypted off-site repository.  Empty means backups are honestly reported
# as unavailable; the stack still starts so the failure is visible.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_PASSWORD_FILE=
RESTIC_CACERT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_ENDPOINT=

BACKUP_DAILY_UTC_HOUR=2
DORMPRINT_CAPACITY_ALERT_PERCENT=85
